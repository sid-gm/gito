{
  "manifest_version": 3,
  "name": "Gito — Send to Gito",
  "version": "1.0.0",
  "description": "One-click capture of social posts into Gito.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://x.com/*",
      "https://twitter.com/*",
      "https://www.threads.net/*",
      "https://www.reddit.com/*",
      "https://www.instagram.com/*"
    ],
    "js": ["content.js"]
  }],
  "action": { "default_popup": "popup.html", "default_icon": "icons/icon48.png" }
}
